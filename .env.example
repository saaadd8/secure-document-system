APP_NAME=Secure Document System
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/secure_docs
# Required: set a unique random secret of at least 32 characters. Do not commit it.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=10485760
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
